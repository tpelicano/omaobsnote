#!/usr/bin/env bash
# test/all -- every suite in this repo. Exits non-zero if any of them fails.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
overall=0

# With STRICT=1 a suite that cannot run is a failure, not a pass. CI sets it, so
# a broken toolchain step can never masquerade as a green run; a developer
# without the Omarchy tree still gets the Node tests.
STRICT="${STRICT:-0}"
skip() {
  echo "SKIP: $1"
  [[ $STRICT == "1" ]] && { echo "  (STRICT=1: treating as a failure)"; overall=1; }
  return 0
}

echo "== node unit tests =="
node --test "$SCRIPT_DIR"/*.test.js || overall=1

echo
echo "== omarchy plugin validate =="
if command -v omarchy-plugin-validate >/dev/null 2>&1; then
  omarchy-plugin-validate "$REPO_DIR" && echo "manifest OK" || overall=1
else
  skip "omarchy-plugin-validate not on PATH"
fi

echo
echo "== qmllint =="
# Qt6's qmllint is the one that understands this QML; a Qt5 binary on PATH is
# not a substitute, so the versioned path wins over a bare `qmllint`.
QMLLINT=""
for candidate in /usr/lib/qt6/bin/qmllint "$(command -v qmllint 2>/dev/null || true)"; do
  [[ -n $candidate && -x $candidate ]] && { QMLLINT="$candidate"; break; }
done

if [[ -n $QMLLINT && -d /usr/share/omarchy/shell ]]; then
  # `import qs.Ui` only resolves when a `qs` directory points at the shell tree.
  QMLROOT="$(mktemp -d)"
  trap 'rm -rf "$QMLROOT"' EXIT
  ln -sfn /usr/share/omarchy/shell "$QMLROOT/qs"
  for f in "$REPO_DIR"/*.qml; do
    errors=$("$QMLLINT" -I "$QMLROOT" -I /usr/share/omarchy/shell "$f" 2>&1 | grep -c ': Error')
    if [[ $errors -ne 0 ]]; then
      echo "FAIL: $(basename "$f") -- $errors errors"
      "$QMLLINT" -I "$QMLROOT" -I /usr/share/omarchy/shell "$f" 2>&1 | grep ': Error'
      overall=1
    else
      echo "ok: $(basename "$f")"
    fi
  done
else
  skip "qmllint or the omarchy shell tree is unavailable"
fi

echo
if [[ $overall -eq 0 ]]; then
  echo "test/all: ALL SUITES PASSED"
else
  echo "test/all: FAILURES ABOVE"
fi
exit $overall
